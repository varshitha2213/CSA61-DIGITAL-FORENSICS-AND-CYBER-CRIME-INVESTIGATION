    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "import shutil\n",
        "import hashlib\n",
        "\n",
        "# -------------------------------\n",
        "# Create a Simulated Storage Device\n",
        "# -------------------------------\n",
        "original_file = \"storage_device.bin\"\n",
        "\n",
        "with open(original_file, \"wb\") as f:\n",
        "    f.write(b\"This is the original storage device data.\")\n",
        "\n",
        "# -------------------------------\n",
        "# Create Bit Stream Copy\n",
        "# -------------------------------\n",
        "copy_file = \"bitstream_copy.bin\"\n",
        "\n",
        "shutil.copyfile(original_file, copy_file)\n",
        "\n",
        "print(\"BIT STREAM COPY CREATED\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "# -------------------------------\n",
        "# Compare File Sizes\n",
        "# -------------------------------\n",
        "original_size = os.path.getsize(original_file)\n",
        "copy_size = os.path.getsize(copy_file)\n",
        "\n",
        "print(\"Original Size :\", original_size, \"bytes\")\n",
        "print(\"Copy Size     :\", copy_size, \"bytes\")\n",
        "\n",
        "# -------------------------------\n",
        "# Calculate SHA-256 Hash\n",
        "# -------------------------------\n",
        "def sha256_hash(filename):\n",
        "    hash_obj = hashlib.sha256()\n",
        "    with open(filename, \"rb\") as f:\n",
        "        while True:\n",
        "            data = f.read(4096)\n",
        "            if not data:\n",
        "                break\n",
        "            hash_obj.update(data)\n",
        "    return hash_obj.hexdigest()\n",
        "\n",
        "original_hash = sha256_hash(original_file)\n",
        "copy_hash = sha256_hash(copy_file)\n",
        "\n",
        "print(\"\\nOriginal SHA-256 :\", original_hash)\n",
        "print(\"Copy SHA-256     :\", copy_hash)\n",
        "\n",
        "# -------------------------------\n",
        "# Verification\n",
        "# -------------------------------\n",
        "if original_size == copy_size and original_hash == copy_hash:\n",
        "    print(\"\\nVerification Successful!\")\n",
        "    print(\"The bit stream copy is a forensically exact replica.\")\n",
        "else:\n",
        "    print(\"\\nVerification Failed!\")\n",
        "    print(\"The copy is not identical to the original.\")"
      ],
