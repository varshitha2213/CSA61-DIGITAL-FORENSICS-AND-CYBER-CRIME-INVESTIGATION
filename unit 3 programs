        "# -------------------------------\n",
        "original_file = \"evidence.txt\"\n",
        "\n",
        "with open(original_file, \"w\") as file:\n",
        "    file.write(\"This is the original digital evidence.\")\n",
        "\n",
        "acquired_file = \"acquired_evidence.txt\"\n",
        "shutil.copy(original_file, acquired_file)\n",
