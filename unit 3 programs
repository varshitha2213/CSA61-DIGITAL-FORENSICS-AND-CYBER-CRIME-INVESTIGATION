        "print(\"SHA-256:\", original_hash)\n",
        "\n",
        "# -------------------------------\n",
        "# Step 3: Verify\n",
        "# -------------------------------\n",
        "verify_hash = calculate_hash(acquired_file)\n",
        "\n",
