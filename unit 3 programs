        "# Experiment 10: Storage Media Analysis\n",
        "# Aim: Calculate Slack Space\n",
        "\n",
        "# Input values\n",
        "file_size = int(input(\"Enter file size (in bytes): \"))\n",
        "cluster_size = int(input(\"Enter cluster size (in bytes): \"))\n",
        "\n",
        "# Calculate allocated space\n",
        "allocated_space = ((file_size + cluster_size - 1) // cluster_size) * cluster_size\n",
        "\n",
        "# Calculate slack space\n",
        "slack_space = allocated_space - file_size\n",
        "\n",
        "# Display results\n",
        "print(\"\\nSTORAGE MEDIA ANALYSIS\")\n",
        "print(\"-\" * 30)\n",
