        "print(\"Step 1: Acquire\")\n",
        "print(\"Evidence acquired successfully.\\n\")\n",
        "\n",
        "# -------------------------------\n",
        "# Function to Calculate SHA-256\n",
        "# -------------------------------\n",
        "def calculate_hash(filename):\n",
        "    sha = hashlib.sha256()\n",
        "\n",
        "    with open(filename, \"rb\") as file:\n",
        "        while True:\n",
        "            data = file.read(4096)\n",
        "            if not data:\n",
        "                break\n",
        "            sha.update(data)\n",
        "\n",
        "    return sha.hexdigest()\n",
        "\n",
        "# -------------------------------\n",
        "# Step 2: Hash\n",
        "# -------------------------------\n",
        "original_hash = calculate_hash(acquired_file)\n",
        "\n",
