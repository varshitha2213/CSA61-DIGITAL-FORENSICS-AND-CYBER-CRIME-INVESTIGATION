        "Experiment 7: Hashing & the Avalanche Effect"
      ],
      "metadata": {
        "id": "pv1oJhdEDA_e"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import hashlib\n",
        "\n",
        "# Original and modified text\n",
        "text1 = \"hello\"\n",
        "text2 = \"Hello\"\n",
        "\n",
        "# Function to generate hashes\n",
        "def generate_hashes(text):\n",
        "    md5 = hashlib.md5(text.encode()).hexdigest()\n",
        "    sha1 = hashlib.sha1(text.encode()).hexdigest()\n",
        "    sha256 = hashlib.sha256(text.encode()).hexdigest()\n",
        "\n",
        "    print(\"Input :\", text)\n",
        "    print(\"MD5    :\", md5)\n",
        "    print(\"SHA-1  :\", sha1)\n",
        "    print(\"SHA-256:\", sha256)\n",
        "    print(\"-\" * 60)\n",
        "\n",
        "# Generate hashes\n",
        "print(\"HASHING & AVALANCHE EFFECT\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "generate_hashes(text1)\n",
        "generate_hashes(text2)\n",
        "\n",
        "# Compare the hashes\n",
        "print(\"Result:\")\n",
        "print(\"Changing one character ('hello' → 'Hello') produces completely different hash values.\")\n",
        "print(\"This demonstrates the Avalanche Effect.\")"
      ],
