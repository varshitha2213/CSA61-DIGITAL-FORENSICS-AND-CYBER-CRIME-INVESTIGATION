        "Experiment 2: Volatile vs Non-Volatile Evidence Capture"
      ],
      "metadata": {
        "id": "V8o276tRJshO"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import hashlib\n",
        "import os\n",
        "\n",
        "# -------------------------------\n",
        "# Volatile Evidence (Simulated)\n",
        "# -------------------------------\n",
        "print(\"VOLATILE EVIDENCE\")\n",
        "print(\"----------------------------\")\n",
        "\n",
        "running_processes = [\n",
        "    \"chrome.exe\",\n",
        "    \"python.exe\",\n",
        "    \"explorer.exe\",\n",
        "    \"notepad.exe\"\n",
        "]\n",
        "\n",
        "print(\"Running Processes:\")\n",
        "for process in running_processes:\n",
        "    print(process)\n",
        "\n",
        "print(\"\\n(Note: Volatile evidence is lost after system shutdown.)\")\n",
        "\n",
        "# -------------------------------\n",
        "# Non-Volatile Evidence\n",
        "# -------------------------------\n",
        "print(\"\\nNON-VOLATILE EVIDENCE\")\n",
        "print(\"----------------------------\")\n",
        "\n",
        "filename = \"evidence.txt\"\n",
        "\n",
        "# Create a sample file\n",
        "with open(filename, \"w\") as file:\n",
        "    file.write(\"This is non-volatile digital evidence.\")\n",
        "\n",
        "# Function to calculate MD5 hash\n",
        "def md5_hash(file_name):\n",
        "    with open(file_name, \"rb\") as file:\n",
        "        data = file.read()\n",
        "        return hashlib.md5(data).hexdigest()\n",
        "\n",
        "# Read the file twice\n",
        "hash1 = md5_hash(filename)\n",
        "hash2 = md5_hash(filename)\n",
        "\n",
        "print(\"File Name :\", filename)\n",
        "print(\"File Size :\", os.path.getsize(filename), \"bytes\")\n",
        "print(\"First MD5 :\", hash1)\n",
        "print(\"Second MD5:\", hash2)\n",
        "\n",
        "# Check integrity\n",
        "if hash1 == hash2:\n",
        "    print(\"\\nResult: Non-volatile evidence remains identical when re-read.\")\n",
        "else:\n",
        "    print(\"\\nResult: File has been modified.\")"
