      ],
      "source": [
        "import hashlib\n",
        "import os\n",
        "\n",
        "# Sample digital evidence files\n",
        "evidence_files = [\n",
        "    \"emails.txt\",\n",
        "    \"browser_history.txt\",\n",
        "    \"chat_logs.txt\",\n",
        "    \"system_logs.txt\"\n",
        "]\n",
        "\n",
        "# Create sample files\n",
        "sample_data = {\n",
        "    \"emails.txt\": \"Email from Alice to Bob.\",\n",
        "    \"browser_history.txt\": \"https://www.google.com\\nhttps://www.github.com\",\n",
        "    \"chat_logs.txt\": \"User1: Hello\\nUser2: Hi\",\n",
        "    \"system_logs.txt\": \"System started successfully.\"\n",
        "}\n",
        "\n",
        "for file, content in sample_data.items():\n",
        "    with open(file, \"w\") as f:\n",
        "        f.write(content)\n",
        "\n",
        "print(\"DIGITAL EVIDENCE CATALOG\")\n",
        "print(\"-\" * 70)\n",
        "print(\"{:<20} {:<12} {:<32}\".format(\"File Name\", \"Size(Bytes)\", \"MD5 Hash\"))\n",
        "print(\"-\" * 70)\n",
        "\n",
        "# Calculate size and MD5 hash\n",
        "for file in evidence_files:\n",
        "    size = os.path.getsize(file)\n",
        "\n",
        "    with open(file, \"rb\") as f:\n",
        "        data = f.read()\n",
        "        md5_hash = hashlib.md5(data).hexdigest()\n",
        "\n",
        "    print(\"{:<20} {:<12} {:<32}\".format(file, size, md5_hash))"
      ]
